# Aplicacao
APP_NAME=antosc-system
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10
CACHE_TOWER_LIST_TTL_SECONDS=5
CACHE_TOWER_DETAIL_TTL_SECONDS=10

# Base de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antosc
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# Cache (opcional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler
SCHEDULER_ENABLED=true
POLL_INTERVAL_SECONDS=45
POLL_BATCH_SIZE=75
POLL_TIMEOUT_SECONDS=10

# Integracoes
SNMP_TIMEOUT_SECONDS=45
SNMP_RETRIES=3
SNMP_SECRET_KEY=change_this_to_a_long_random_secret
AUTH_API_KEY_HASH=6e1e4e1b8f8b36d08901cdb51b97841dfe20f5efd2fd2fd00768971408c46274
AUTH_BEARER_TOKEN=dev-token
AUTH_USER_TOKEN_SECRET=change_this_user_token_secret
AUTH_USER_TOKEN_TTL_MIN=480
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change_me
AUTH_BOOTSTRAP_ROLE=admin
RATE_LIMIT_WRITE_PER_MINUTE=120

# Grafana local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
 