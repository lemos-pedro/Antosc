# Aplicacao
APP_NAME=antosc-system
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10

# Base de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antosc
