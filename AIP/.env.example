AIP_ENV=dev
AIP_LOG_LEVEL=info
AIP_API_PORT=8090

TOWERCORE_URL=http://localhost:8000
AIP_PREDICTION_SERVICE_URL=http://localhost:9000
GENERATOR_API_URL=http://localhost:8001
AIP_BASE_URL=http://localhost:8090

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

AIP_DB_HOST=localhost
AIP_DB_PORT=5432
AIP_DB_USER=postgres
AIP_DB_PASSWORD=postgres
AIP_DB_NAME=aip
AIP_DB_SSLMODE=disable

# Resend — relatórios por email
RESEND_API_KEY=
RESEND_FROM=alerts@antosc.com

# Teams — alertas de limiar em tempo real
TEAMS_WEBHOOK_URL=

# --- Relatórios por persona (cmd/report_job) ---
# REPORT_PERIOD=weekly|monthly
# Só personas com emails definidos recebem o relatório.
REPORT_RECIPIENTS_OM=
REPORT_RECIPIENTS_ENGENHARIA=
REPORT_RECIPIENTS_CONTROLLER=
REPORT_RECIPIENTS_FINANCEIRO=
REPORT_RECIPIENTS_DIRETOR_TECNICO=
REPORT_RECIPIENTS_CEO=
REPORT_RECIPIENTS_CONSELHO_ADMINISTRACAO=

# Legado (cmd/weekly_report) — lista única
WEEKLY_REPORT_RECIPIENTS=

# Proteção Power BI / exports (vazio = aberto, só para dev)
AIP_API_KEY=

# predict_batch
PREDICT_MODELS=health_score
PREDICT_WINDOW_DAYS=7

# Auth utilizadores (JWT)
AIP_JWT_SECRET=change-me-to-a-long-random-secret-32+
AIP_JWT_TTL_HOURS=24

# API key (Power BI + tools do assistente). Se vazio, usa o JWT secret como chave de serviço.
AIP_API_KEY=

# Seed de utilizadores (make seed)
SEED_PASSWORD=Trocar123!
SEED_EMAIL_DOMAIN=antosc.local

# Access token curto (horas); refresh longo
AIP_JWT_TTL_HOURS=1
AIP_REFRESH_TTL_HOURS=168
AIP_MAX_FAILED_LOGINS=5
AIP_LOCKOUT_MINUTES=15
